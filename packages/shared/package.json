{
  "name": "@live1024/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared DTO types for live-1024 (types only, no runtime code)",
  "types": "src/index.ts",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./diagnostics": {
      "types": "./src/diagnostics.ts",
      "default": "./src/diagnostics.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module"
}
