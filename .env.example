# 服务端运行凭证（只在 apps/server 进程内使用，绝不下发到浏览器）
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，不要提交。
POLYV_APP_ID=your_app_id
POLYV_APP_SECRET=your_app_secret
POLYV_USER_ID=your_user_id

# 健康检查用的频道号（可选，不填则只探活接口）
POLYV_HEALTH_CHANNEL_ID=

# 服务端口（默认 3000）
PORT=3000

# AI 诊断解释（DeepSeek，OpenAI 兼容接口）：不填 key 时 /api/channels/:id/analyze 走规则引擎兜底
# key 只在服务端进程内使用，绝不下发浏览器，也不要写进源码 / 日志
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
